# 复制为 .env 后再按部署环境修改；不要把 .env 提交到 Git。

MYSQL_DATABASE=sentinel
MYSQL_USER=sentinel
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace-with-strong-mongo-password

RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password

# 可选：日报发送配置。没有配置时只在本地生成日报，不会外发。
STATUS_API_URL=http://127.0.0.1:8088
FEISHU_WEBHOOK_URL=
