[Unit]
Description=Sentinel Monitor daily health report
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sentinel-monitor
EnvironmentFile=-/etc/sentinel-monitor/report.env
ExecStart=/usr/bin/python3 /opt/sentinel-monitor/ops/health-report.py
TimeoutStartSec=180
NoNewPrivileges=true
